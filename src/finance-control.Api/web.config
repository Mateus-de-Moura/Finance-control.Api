<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.webServer>

		<modules>
			<remove name="WebDAVModule"/>
		</modules>

		<handlers>
			<remove name="WebDAV"/>
		</handlers>

		<aspNetCore processPath="dotnet"
					arguments=".\finance-control.Api.dll"
					stdoutLogEnabled="true"
					stdoutLogFile=".\logs\stdout"
					hostingModel="inprocess" />

	</system.webServer>
</configuration>
